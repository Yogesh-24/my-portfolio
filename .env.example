# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=

# --- Supabase (testimonials storage) ---
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=
# The SECRET key (sb_secret_…), not the publishable one — this bypasses RLS
# and must never reach the browser.
SUPABASE_SECRET_KEY=

# --- Resend (email notifications) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Portfolio <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=
# Where contact messages + new-testimonial alerts are sent.
NOTIFY_TO_EMAIL=
